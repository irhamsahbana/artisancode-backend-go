APP_NAME=go-backend
APP_PORT=3000
APP_ENV=development
APP_LOG_LEVEL=debug
APP_LOG_FILE=./logs/app.log
APP_LOG_FILE_WS=./logs/app_ws.log
APP_LOG_FILE_ACCESS=./logs/access.log

INSTRUMENTATION_ENABLED=false
INSTRUMENTATION_OTLP_ENDPOINT=localhost:14317
INSTRUMENTATION_OTLP_INSECURE=true
INSTRUMENTATION_OTLP_HEADERS=
INSTRUMENTATION_DEBUG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user_app
POSTGRES_PASSWORD=password_app
POSTGRES_DB=app_dev
POSTGRES_SSL_MODE=require
POSTGRES_CHANNEL_BINDING=require

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://admin:admin@localhost:5432/admin_db
GOOSE_MIGRATION_DIR=./migrations

DB_CONN_TIMEOUT=30
DB_MAX_OPEN_CONS=20
DB_MAX_IDLE_CONS=10
DB_CONN_MAX_LIFETIME=0

JWT_PRIVATE_KEY=xxx
SHARED_LINK_EXP=5 # in minutes

OPENAI_API_KEY=sk-
OPENAI_API_BASE_URL=https://api.openai.com/v1

MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME="info@xxx.com"
MAIL_SMTP_PASSWORD="svuo dasd xcz xiqb"
MAIL_SMTP_FROM="info@xxx.com"

ADMIN_EMAIL_ADDRESS="irham.sahbana@xxx.com"

STORAGE_KEY=xx
STORAGE_SECRET=xxx
STORAGE_ENDPOINT=https://xxx.digitaloceanspaces.com
STORAGE_REGION=xxx2
STORAGE_BUCKET=xxx-xxx-space
STORAGE_IS_USE_PATH_STYLE=true

FRONTEND_CLIENT_BASE_URL=http://localhost:5000
FRONTEND_ADMIN_BASE_URL=http://localhost:6000
APP_EMAIL_LOGO_URL=https://artisanco.de/favicon.png
NATS_URL=nats://localhost:4222

SCHEDULER_STORAGE_CLEANUP_SPEC=*/30 * * * *
